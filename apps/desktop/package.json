{
  "name": "@jarvis/desktop",
  "version": "0.1.0",
  "description": "ZARVIS Windows Desktop Client & Compact Floating HUD",
  "author": "ZARVIS Team",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc && node scripts/build-renderer.js",
    "stage:runtimes": "node scripts/stage-runtimes.js",
    "start": "electron .",
    "test": "node --test dist/__tests__/**/*.test.js",
    "pack": "npm run build && npm run stage:runtimes && npx electron-builder --dir",
    "dist": "npm run build && npm run stage:runtimes && npx electron-builder",
    "dist:win": "npm run build && npm run stage:runtimes && npx electron-builder --win"
  },
  "dependencies": {
    "@jarvis/protocol": "file:../../packages/protocol",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/ws": "^8.5.10",
    "electron": "33.2.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4"
  },
  "build": {
    "appId": "com.zarvis.desktop",
    "productName": "ZARVIS",
    "electronVersion": "33.2.1",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-resources/python",
        "to": "python",
        "filter": ["**/*"]
      },
      {
        "from": "build-resources/python-core",
        "to": "python-core",
        "filter": ["**/*"]
      },
      {
        "from": "build-resources/node",
        "to": "node",
        "filter": ["**/*"]
      },
      {
        "from": "build-resources/node-gateway",
        "to": "node-gateway",
        "filter": ["**/*"]
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZARVIS",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
