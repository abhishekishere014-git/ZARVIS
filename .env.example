# ==============================================================================
# JARVIS PLATFORM CONFIGURATION (TEMPLATE)
# IMPORTANT: Never commit actual API keys, passwords, or tokens to version control.
# Sensitive provider credentials should be configured through the JARVIS Vault
# (Windows Credential Manager / keyring) or set locally in uncommitted .env.
# ==============================================================================

# --- Environment & Runtime ---
JARVIS_ENV=development
JARVIS_DEBUG=true
JARVIS_LOG_LEVEL=INFO

# --- Python Core Service ---
JARVIS_CORE_HOST=127.0.0.1
JARVIS_CORE_PORT=8765
JARVIS_DATA_DIR=./data
JARVIS_VAULT_BACKEND=keyring

# --- Node Gateway Service ---
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3000
PYTHON_CORE_URL=ws://127.0.0.1:8765
GATEWAY_LOG_LEVEL=info

# --- Placeholder for future provider integrations (stored in Vault) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
