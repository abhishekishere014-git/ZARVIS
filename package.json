{
  "name": "jarvis-platform",
  "version": "0.1.0",
  "private": true,
  "description": "ZARVIS - Local-First Intelligent Windows Desktop Assistant",
  "workspaces": [
    "packages/*",
    "services/node-gateway",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test:protocol": "npm test --workspace=@jarvis/protocol",
    "test:gateway": "npm test --workspace=@jarvis/node-gateway",
    "test:desktop": "npm test --workspace=@jarvis/desktop",
    "test:node": "npm run test:protocol && npm run test:gateway && npm run test:desktop",
    "test:python": ".venv\\Scripts\\pytest tests/python --basetemp=.pytest_temp",
    "test": "npm run test:node && npm run test:python",
    "start:gateway": "npm start --workspace=@jarvis/node-gateway",
    "start:desktop": "npm start --workspace=@jarvis/desktop",
    "start:python": ".venv\\Scripts\\python services/python-core/jarvis/__main__.py",
    "pack:desktop": "npm run pack --workspace=@jarvis/desktop",
    "dist:desktop": "npm run dist --workspace=@jarvis/desktop",
    "preview": ".venv\\Scripts\\python scripts/preview_demo.py"
  }
}
